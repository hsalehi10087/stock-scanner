# 📋 نمونهٔ Environment Variables
# کاپی کن به .env و مقادیر را پر کن
# NEVER commit .env file!

# 🤖 Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE

# 📝 نحوهٔ دریافت:
# 1. Bot Token: @BotFather > /newbot > copy token
# 2. Chat ID: @userinfobot > /start > copy ID (negative number)

# ⚠️ SECURITY:
# - هیچ‌وقت این فایل را commit نکن اگر values پر باشد
# - .env همیشه در .gitignore است
# - GitHub Secrets برای CI/CD تنظیم کن
